# ─── Server-only — never expose to the browser ───────────────────────

# Google OAuth (optional - for Google login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=
# Public origin for Auth.js redirects (production). Example: https://murmur.app
AUTH_URL=
# Local dev only — route OAuth through Clash/Surge when Google is blocked (e.g. http://127.0.0.1:7890)
# HTTPS_PROXY=

# OpenAI-compatible chat endpoint used by /api/strummer/edit.
# Defaults are fine for OpenAI itself; use AI_GATEWAY_* for a custom proxy.
OPENAI_API_KEY=
OPENAI_BASE_URL=
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=

# Audio worker URL used by /api/transcribe. Real recordings go through the
# server route; fixture is available only through the explicit demo action.
AUDIO_WORKER_URL=
AUDIO_WORKER_TOKEN=
AUDIO_ENGINE_PITCH_PROVIDER=auto
AUDIO_ENGINE_DENOISE_PROVIDER=auto

# Magenta RealTime music worker used by /api/music/generate (vibe clips).
# Production (recommended): RunPod Serverless — one command:
#   RUNPOD_API_KEY=rpa_… VERCEL=1 bun run deploy:music-serverless
# The app invokes the endpoint with RUNPOD_API_KEY as the bearer; the deploy
# script writes both of these to Vercel. See docs/DEPLOY_MUSIC_ENGINE_GPU.md.
RUNPOD_SERVERLESS_ENDPOINT_ID=
RUNPOD_API_KEY=
# Deploy knobs (scripts/deploy-music-serverless.ts) — all optional:
RUNPOD_DATA_CENTER_ID=          # network-volume datacenter (default EU-RO-1)
RUNPOD_NETWORK_VOLUME_ID=       # reuse an existing volume instead of creating one
RUNPOD_GPU_TYPE_ID=             # preferred GPU, e.g. "NVIDIA L4"
# The ghcr image is public, so RunPod pulls it anonymously — leave these blank.
# Fallback if it ever goes private: a GHCR PAT (classic, read:packages); the
# deploy script registers it as a RunPod cred "murmur-ghcr" (the PAT owner needs
# read access to the org's packages). Or reuse an existing RUNPOD_REGISTRY_AUTH_ID.
GHCR_USERNAME=                  # GitHub username owning the PAT (fallback only)
GHCR_TOKEN=                     # classic PAT with read:packages (fallback only)
RUNPOD_REGISTRY_AUTH_ID=        # or reuse an already-registered RunPod cred id
MURMUR_MUSIC_IMAGE=ghcr.io/p-to-q/murmur-music-engine:latest
# Model served by the worker: mrt2_base (M-series Pro/Max) | mrt2_small
MAGENTA_MODEL=mrt2_base
#
# Dev / legacy HTTP worker. Local `bun run dev:music` defaults to
# http://127.0.0.1:8002; in production these are ignored once
# RUNPOD_SERVERLESS_ENDPOINT_ID is set.
MUSIC_WORKER_URL=
MUSIC_WORKER_TOKEN=

# Auth mode defaults to production-like behavior even on localhost: no valid
# session means 401. Set to demo/local only for explicit preview fallback work.
MURMUR_AUTH_MODE=
# Browser-side companion for local header auth. Keep unset unless
# MURMUR_AUTH_MODE=local and you intentionally want localStorage user headers.
NEXT_PUBLIC_MURMUR_AUTH_MODE=
# Local/demo only. Production session auth must use bearer/cookie/Auth.js
# sessions; v1 header identity is ignored in production auth mode even if set.
MURMUR_ALLOW_HEADER_AUTH=
MURMUR_ALLOW_DEV_BILLING_FALLBACK=1
# When set to 1/true, also enables billing fallback on non-loopback hosts (staging/demo only).
MURMUR_DEV_NOTES_BALANCE=9999
# Canonical app origin for metadata, share URLs, and payment return links.
# Example: https://murmur.app
MURMUR_APP_URL=

# ─── Waffo Pancake (src/lib/billing/waffo.ts) ────────────────────────
# Merchant credentials from https://pancake.waffo.ai/merchant/dashboard/integration
# When unset, /api/billing/checkout answers 503 and local dev simulates checkout.
WAFFO_MERCHANT_ID=
# RSA private key PEM, or use WAFFO_PRIVATE_KEY_BASE64 for CI/Vercel
WAFFO_PRIVATE_KEY=
WAFFO_PRIVATE_KEY_BASE64=
# One-time product for note top-ups (create via: bun run waffo:bootstrap)
WAFFO_TOPUP_PRODUCT_ID=
WAFFO_STORE_ID=
# Webhook registration (scripts/waffo-webhook-register.ts)
WAFFO_WEBHOOK_URL=https://murmur.ptoq.io/api/billing/webhook
# Set to 0/false for production webhook; defaults to testMode unless URL is localhost
WAFFO_WEBHOOK_TEST_MODE=0

# ─── Database (Drizzle ORM) ──────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/myapp
POSTGRES_URL=

# Optional Turso/libSQL alternative
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Vercel Cron shared secret
CRON_SECRET=replace_with_a_long_random_string

# ─── Object storage (src/lib/storage) ────────────────────────────────
# REQUIRED in production — the app refuses to start without a driver.
# Dev defaults to "local-fs"; test defaults to "memory".
MURMUR_STORAGE_DRIVER=
# Root dir for the local-fs adapter. Defaults to .murmur/storage under cwd.
MURMUR_STORAGE_LOCAL_DIR=

# ─── Rate limiter (src/lib/rate-limit) ───────────────────────────────
# Token-bucket store backing the rate-limit substrate. Dev defaults to
# "memory"; redis/postgres adapters are planned but not yet shipped.
MURMUR_RATE_LIMIT_DRIVER=

# s3-compatible adapter (used by R2, AWS S3, 腾讯云 COS). All four
# credentials are required when MURMUR_STORAGE_DRIVER=s3-compatible.
MURMUR_STORAGE_S3_BUCKET=
MURMUR_STORAGE_S3_REGION=
MURMUR_STORAGE_S3_ACCESS_KEY_ID=
MURMUR_STORAGE_S3_SECRET_ACCESS_KEY=
# Endpoint override for non-AWS targets, e.g.:
#   https://<accountid>.r2.cloudflarestorage.com   (Cloudflare R2)
#   https://cos.ap-shanghai.myqcloud.com            (腾讯云 COS)
# Leave unset to talk to real AWS S3.
MURMUR_STORAGE_S3_ENDPOINT=
# Public CDN base for `scope: "public"` objects (share posters, etc.).
# Required if you ever write public-scope objects.
MURMUR_STORAGE_S3_PUBLIC_URL_BASE=
