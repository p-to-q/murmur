# ─── Server-only — never expose to the browser ───────────────────────

# Google OAuth (optional - for Google login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=
# Public origin for Auth.js redirects (production). Example: https://murmur.app
AUTH_URL=
# Local dev only — route OAuth through Clash/Surge when Google is blocked (e.g. http://127.0.0.1:7890)
# HTTPS_PROXY=

# OpenAI-compatible chat endpoint used by /api/strummer/edit.
# Defaults are fine for OpenAI itself; use AI_GATEWAY_* for a custom proxy.
OPENAI_API_KEY=
OPENAI_BASE_URL=
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=

# Audio worker URL used by /api/transcribe. Real recordings go through the
# server route; fixture is available only through the explicit demo action.
AUDIO_WORKER_URL=
AUDIO_WORKER_TOKEN=
AUDIO_ENGINE_PITCH_PROVIDER=auto
AUDIO_ENGINE_DENOISE_PROVIDER=auto

# Magenta RealTime music worker used by /api/music/generate (vibe clips).
# Dev defaults to http://127.0.0.1:8002 (bun run dev:music); leave unset in
# production to fall back to the legacy Tone.js synth engine.
MUSIC_WORKER_URL=
MUSIC_WORKER_TOKEN=
# Model served by the worker: mrt2_base (M-series Pro/Max) | mrt2_small
MAGENTA_MODEL=mrt2_base

# Local/demo only. Production session auth must use bearer/cookie sessions;
# leaving this unset disables v1 header identity when NODE_ENV=production.
MURMUR_ALLOW_HEADER_AUTH=
MURMUR_ALLOW_DEV_BILLING_FALLBACK=1
# When set to 1/true, also enables billing fallback on non-loopback hosts (staging/demo only).
MURMUR_DEV_NOTES_BALANCE=9999
# Canonical app origin for metadata, share URLs, and Stripe return links.
# Example: https://murmur.app
MURMUR_APP_URL=

# ─── Stripe (src/lib/billing/stripe.ts) ──────────────────────────────
# Secret key from https://dashboard.stripe.com/apikeys. When unset,
# /api/billing/checkout answers 503 and local dev simulates checkout.
STRIPE_SECRET_KEY=
# Signing secret for the /api/billing/webhook endpoint. Local testing:
#   stripe listen --forward-to localhost:3000/api/billing/webhook
STRIPE_WEBHOOK_SECRET=
# Optional pre-created Price ids per SKU. When unset, checkout uses inline
# price_data from the canonical @murmur/core TOPUP_SKUS table.
STRIPE_PRICE_TOPUP_30_NOTES=
STRIPE_PRICE_TOPUP_120_NOTES=
STRIPE_PRICE_TOPUP_400_NOTES=

# ─── Database (Drizzle ORM) ──────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/myapp
POSTGRES_URL=

# Optional Turso/libSQL alternative
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Vercel Cron shared secret
CRON_SECRET=replace_with_a_long_random_string

# ─── Object storage (src/lib/storage) ────────────────────────────────
# REQUIRED in production — the app refuses to start without a driver.
# Dev defaults to "local-fs"; test defaults to "memory".
MURMUR_STORAGE_DRIVER=
# Root dir for the local-fs adapter. Defaults to .murmur/storage under cwd.
MURMUR_STORAGE_LOCAL_DIR=

# ─── Rate limiter (src/lib/rate-limit) ───────────────────────────────
# Token-bucket store backing the rate-limit substrate. Dev defaults to
# "memory"; redis/postgres adapters are planned but not yet shipped.
MURMUR_RATE_LIMIT_DRIVER=

# s3-compatible adapter (used by R2, AWS S3, 腾讯云 COS). All four
# credentials are required when MURMUR_STORAGE_DRIVER=s3-compatible.
MURMUR_STORAGE_S3_BUCKET=
MURMUR_STORAGE_S3_REGION=
MURMUR_STORAGE_S3_ACCESS_KEY_ID=
MURMUR_STORAGE_S3_SECRET_ACCESS_KEY=
# Endpoint override for non-AWS targets, e.g.:
#   https://<accountid>.r2.cloudflarestorage.com   (Cloudflare R2)
#   https://cos.ap-shanghai.myqcloud.com            (腾讯云 COS)
# Leave unset to talk to real AWS S3.
MURMUR_STORAGE_S3_ENDPOINT=
# Public CDN base for `scope: "public"` objects (share posters, etc.).
# Required if you ever write public-scope objects.
MURMUR_STORAGE_S3_PUBLIC_URL_BASE=
