# ─── Server-only — never expose to the browser ───────────────────────

# Google OAuth (optional — button hidden when absent)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (optional — button hidden when absent)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email OTP via Resend (optional — button hidden when absent)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Murmur <noreply@murmur.ptoq.io>

# Auth.js shared secret (required when any OAuth provider is configured)
AUTH_SECRET=
# Public origin for Auth.js redirects (production). Example: https://murmur.app
AUTH_URL=
# Local dev only — route OAuth through Clash/Surge when Google is blocked (e.g. http://127.0.0.1:7890)
# HTTPS_PROXY=

# OpenAI-compatible chat endpoint used by /api/strummer/edit.
# Defaults are fine for OpenAI itself; use AI_GATEWAY_* for a custom proxy.
OPENAI_API_KEY=
OPENAI_BASE_URL=
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=

# Audio worker URL used by /api/transcribe. Real recordings go through the
# server route; fixture is available only through the explicit demo action.
AUDIO_WORKER_URL=
# Required for any deployed/public audio worker. Local loopback dev may leave it
# empty, but production workers fail fast without it.
AUDIO_WORKER_TOKEN=
AUDIO_ENGINE_PITCH_PROVIDER=auto
# RMVPE is the preferred server pitch path when a baked model is available.
# Without a model, AUDIO_ENGINE_PITCH_PROVIDER=auto falls back to SwiftF0/pYIN.
AUDIO_ENGINE_RMVPE_MODEL_PATH=
AUDIO_ENGINE_RMVPE_DEVICE=cpu
AUDIO_ENGINE_RMVPE_ALLOW_DOWNLOAD=0
AUDIO_ENGINE_RMVPE_CONFIDENCE_THRESHOLD=0.03
AUDIO_ENGINE_DENOISE_PROVIDER=auto

# Magenta RealTime music worker used by /api/music/generate (vibe clips).
# Production (recommended): RunPod Serverless — one command:
#   RUNPOD_API_KEY=rpa_… VERCEL=1 bun run deploy:music-serverless
# The app invokes the endpoint with RUNPOD_API_KEY as the bearer; the deploy
# script writes both of these to Vercel. See docs/DEPLOY_MUSIC_ENGINE_GPU.md.
RUNPOD_SERVERLESS_ENDPOINT_ID=
RUNPOD_API_KEY=
# Monitoring only: effective RunPod GPU rate used for per-job cost estimates.
# It never blocks or downgrades generation.
RUNPOD_GPU_USD_PER_SECOND=
# Enable only after deploy:music-serverless proves the versioned Worker receipt.
# Until then Web still applies its independent WAV Gate during rolling upgrades.
MURMUR_MUSIC_QUALITY_EVIDENCE_REQUIRED=
# Enable only after a v2 SHA endpoint passes the full deployment warm-up.
MURMUR_MUSIC_V2_EVIDENCE_REQUIRED=
# Deploy knobs (scripts/deploy-music-serverless.ts) — all optional:
RUNPOD_DATA_CENTER_ID=          # network-volume datacenter (default EU-RO-1)
RUNPOD_NETWORK_VOLUME_ID=       # reuse an existing volume instead of creating one
RUNPOD_GPU_TYPE_ID=             # preferred GPU, e.g. "NVIDIA L4"
# The ghcr image is public, so RunPod pulls it anonymously — leave these blank.
# Fallback if it ever goes private: a GHCR PAT (classic, read:packages); the
# deploy script registers it as a RunPod cred "murmur-ghcr" (the PAT owner needs
# read access to the org's packages). Or reuse an existing RUNPOD_REGISTRY_AUTH_ID.
GHCR_USERNAME=                  # GitHub username owning the PAT (fallback only)
GHCR_TOKEN=                     # classic PAT with read:packages (fallback only)
RUNPOD_REGISTRY_AUTH_ID=        # or reuse an already-registered RunPod cred id
MURMUR_MUSIC_RELEASE_SHA=      # immutable Worker image SHA; deploy script defaults to HEAD
MURMUR_MUSIC_IMAGE=            # optional immutable SHA tag or @sha256 digest override
# Model served by the worker: mrt2_base (M-series Pro/Max) | mrt2_small
MAGENTA_MODEL=mrt2_base
MAGENTA_CFG_NOTES=1.5
MAGENTA_TEMPERATURE=1.3
MAGENTA_TOP_K=40
# Generate no more than 1-3 candidates inside one paid Worker job.
MUSIC_QUALITY_MAX_ATTEMPTS=2
# Worker-wide candidate retry budget. Keep below RunPod's 180s execution cap.
MUSIC_QUALITY_MAX_TOTAL_SECONDS=165
#
# Transport switch: serverless | http (alias pod) | auto (default).
#   auto       → serverless when configured, else the HTTP worker/pod
#   http/pod   → force the long-lived HTTP worker / GPU pod (MUSIC_WORKER_URL)
#   serverless → force the RunPod Serverless endpoint
# Flip this (+ redeploy) to move live traffic between the two without
# unconfiguring either; the pod scripts can set it for you (VERCEL=1).
MUSIC_ENGINE_MODE=
#
# HTTP worker (http mode) + local `bun run dev:music` (defaults to
# http://127.0.0.1:8002). In production this is a warm RunPod GPU *pod* — an
# always-available GPU with no serverless cold start. Manage it with:
#   bun run pod:create | pod:start | pod:stop | pod:status
# The URL is https://<podId>-8002.proxy.runpod.net; the token must match the
# pod's MUSIC_WORKER_TOKEN. Ignored in prod unless MUSIC_ENGINE_MODE selects it.
MUSIC_WORKER_URL=
# Required whenever MUSIC_WORKER_URL points at a deployed/public HTTP worker.
# Local loopback dev may leave it empty.
MUSIC_WORKER_TOKEN=

# Test-only melody diagnostics. The hidden Melo Lab page can exist as a debug
# surface, but its APIs only call loopback workers and never production workers.
# Production builds require MURMUR_ENABLE_MELO_LAB=1 before those APIs respond.
MELO_LAB_AUDIO_WORKER_URL=http://127.0.0.1:8001
MELO_LAB_MUSIC_WORKER_URL=http://127.0.0.1:8002
MURMUR_ENABLE_MELO_LAB=

# Debug/observability surface (e.g. /api/observability/recent-events).
# Always on outside production; in production it stays off unless set to
# 1/true, so the in-memory recent-events buffer is never exposed by accident.
MURMUR_ENABLE_DEBUG_SURFACE=

# Auth mode defaults to production-like behavior even on localhost: no valid
# session means 401. Set to demo/local only for explicit preview fallback work.
MURMUR_AUTH_MODE=
# Browser-side companion for local header auth. Keep unset unless
# MURMUR_AUTH_MODE=local and you intentionally want localStorage user headers.
NEXT_PUBLIC_MURMUR_AUTH_MODE=
# Base URL the client uses to reach the API. Leave UNSET for the web build
# (same-origin relative /api fetches). Native (Capacitor iOS/Android) and
# WeChat 小程序 builds must set it at build time to the deployed Next.js host,
# or their /api calls 404. Browser-exposed (NEXT_PUBLIC_).
NEXT_PUBLIC_MURMUR_API_BASE_URL=
# Optional overrides for the Me screen version string. Defaults come from
# package.json (SemVer), next.config.ts (build), and git/Vercel (SHA).
# NEXT_PUBLIC_APP_VERSION=0.5.0
# NEXT_PUBLIC_APP_BUILD=110
# Local/demo only. Production session auth must use bearer/cookie/Auth.js
# sessions; v1 header identity is ignored in production auth mode even if set.
MURMUR_ALLOW_HEADER_AUTH=
# Non-production billing fallback for staging/demo environments.
MURMUR_ALLOW_DEV_BILLING_FALLBACK=1
# Production stays fail-closed regardless of Host/URL. Set this server-only flag
# to 1/true only for an intentional production demo/local-preview deployment.
MURMUR_ALLOW_PRODUCTION_LOCAL_PREVIEW=
# Explicit deployment identity. Set to preview or production in the matching
# Vercel environment; builds fail when the declaration and target differ.
MURMUR_DEPLOYMENT_ENV=
# Non-secret resource identities used only by release preflight. Configure
# separate plain values for Preview and Production in Vercel.
MURMUR_DATABASE_RESOURCE_ID=
MURMUR_STORAGE_RESOURCE_ID=
MURMUR_AUDIO_WORKER_RESOURCE_ID=
MURMUR_MUSIC_WORKER_RESOURCE_ID=
MURMUR_DEV_NOTES_BALANCE=9999
# Canonical app origin for metadata, share URLs, and payment return links.
# Example: https://murmur.app
MURMUR_APP_URL=

# Browser Web Push for system notifications while Murmur is in the background.
# Generate with:
#   npx web-push generate-vapid-keys
# Private key must stay server-only.
WEB_PUSH_PRIVATE_KEY=
# Public key is returned to the browser by /api/notifications/push/public-key.
WEB_PUSH_PUBLIC_KEY=
# mailto:ops@example.com or https://example.com, used as the VAPID subject.
WEB_PUSH_SUBJECT=

# ─── Waffo Pancake (src/lib/billing/waffo.ts) ────────────────────────
# Merchant credentials from https://pancake.waffo.ai/merchant/dashboard/integration
# When unset, /api/billing/checkout answers 503 and local dev simulates checkout.
WAFFO_MERCHANT_ID=
# RSA private key PEM, or use WAFFO_PRIVATE_KEY_BASE64 for CI/Vercel
WAFFO_PRIVATE_KEY=
WAFFO_PRIVATE_KEY_BASE64=
# One-time product for note top-ups (create via: bun run waffo:bootstrap)
WAFFO_TOPUP_PRODUCT_ID=
WAFFO_STORE_ID=
# Webhook registration (scripts/waffo-webhook-register.ts)
WAFFO_WEBHOOK_URL=https://murmur.ptoq.io/api/billing/webhook
# Set to 0/false for production webhook; defaults to testMode unless URL is localhost
WAFFO_WEBHOOK_TEST_MODE=0

# ─── zpay (z-pay.cn) — Alipay / WeChat Pay for CNY ─────────────────
# Register at https://z-pay.cn/ to get pid + key.
# When unset, explicit WeChat checkout returns 503 and CNY card checkout stays on Waffo.
# Production checkout remains disabled even with credentials until this explicit
# launch-gate flag is set, because Murmur does not yet receive ZPay refund /
# chargeback webhooks for notes-ledger reversal.
ZPAY_PID=
ZPAY_KEY=
MURMUR_ALLOW_PRODUCTION_ZPAY_WITHOUT_REFUNDS=

# ─── Database (Drizzle ORM) ──────────────────────────────────────────
# One fail-closed DSN resolver (src/lib/db/config.ts) serves the runtime client,
# the migration script, and Drizzle Kit. Precedence (first non-empty wins):
#   Runtime (pooled):     DATABASE_URL -> POSTGRES_URL
#   Migrations (direct):  DATABASE_URL_UNPOOLED -> POSTGRES_URL_NON_POOLING
#                          -> DATABASE_URL -> POSTGRES_URL
# With no DSN set, scripts throw instead of silently targeting localhost. The
# localhost fallback below is used only under an explicit local-dev signal
# (NODE_ENV=development/test, or MURMUR_DB_ALLOW_LOCAL_FALLBACK=1).
#
# Production Neon deployments must use the pooled hostname for the runtime URL:
#   ep-...-pooler.<region>.aws.neon.tech
# Direct ep-...<region>.aws.neon.tech endpoints fail the production env audit.
DATABASE_URL=postgresql://postgres:password@localhost:5432/myapp
POSTGRES_URL=
# Direct (non-pooler) endpoint used only for migrations, where it wins over the
# pooled URLs. Set one of these as the production migration secret.
DATABASE_URL_UNPOOLED=
POSTGRES_URL_NON_POOLING=
# Opt in to the localhost DSN fallback when NODE_ENV is unset (local scripts).
MURMUR_DB_ALLOW_LOCAL_FALLBACK=
# Per-instance postgres-js pool bound. Defaults to 5; accepted range is 1-10.
# Tune only with production connection-limit and load-test evidence.
MURMUR_DB_POOL_MAX=

# Optional Turso/libSQL alternative
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Vercel Cron shared secret. Authorizes billing, account-deletion, and
# song-audio lifecycle workers; use a non-placeholder value in production.
CRON_SECRET=replace_with_a_long_random_string

# ─── Object storage (src/lib/storage) ────────────────────────────────
# REQUIRED in production — the app refuses to start without a driver.
# Dev defaults to "local-fs"; test defaults to "memory".
MURMUR_STORAGE_DRIVER=
# Root dir for the local-fs adapter. Defaults to .murmur/storage under cwd.
MURMUR_STORAGE_LOCAL_DIR=

# ─── Rate limiter (src/lib/rate-limit) ───────────────────────────────
# Token-bucket store backing the rate-limit substrate. Dev defaults to
# "memory"; production defaults to "postgres". Redis is planned but not yet
# shipped, so do not configure "redis" for production deployments.
MURMUR_RATE_LIMIT_DRIVER=

# s3-compatible adapter (used by R2, AWS S3, 腾讯云 COS). All four
# credentials are required when MURMUR_STORAGE_DRIVER=s3-compatible.
MURMUR_STORAGE_S3_BUCKET=
MURMUR_STORAGE_S3_REGION=
MURMUR_STORAGE_S3_ACCESS_KEY_ID=
MURMUR_STORAGE_S3_SECRET_ACCESS_KEY=
# Endpoint override for non-AWS targets, e.g.:
#   https://<accountid>.r2.cloudflarestorage.com   (Cloudflare R2)
#   https://cos.ap-shanghai.myqcloud.com            (腾讯云 COS)
# Leave unset to talk to real AWS S3.
MURMUR_STORAGE_S3_ENDPOINT=
# Public CDN base for `scope: "public"` objects (share posters, etc.).
# Required if you ever write public-scope objects.
MURMUR_STORAGE_S3_PUBLIC_URL_BASE=
# Production-only acknowledgement: set true only after the bucket has a tested
# lifecycle rule that expires the private tmp/ prefix within 24 hours.
MURMUR_STORAGE_TMP_LIFECYCLE_CONFIRMED=
# Expand/contract switch for private song masters. Keep false/unset for the
# first release that adds controlled audio routes; enable only after that
# release is the tested rollback baseline.
MURMUR_PRIVATE_SONG_AUDIO_DELIVERY=
