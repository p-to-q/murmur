# ─── Client-safe (NEXT_PUBLIC_*) — exposed to the browser ────────────

# Stainer transcription provider order. The facade always falls through to
# fixture so the user is never stuck.
#   browser-yin         — default. Zero-deps, offline, instant.
#   remote-python       — higher accuracy. Requires the PYIN worker below.
#   browser-basic-pitch — opt-in. Downloads ~7MB model from CDN; slower.
#   fixture             — demo only.
NEXT_PUBLIC_TRANSCRIPTION_PROVIDER=browser-yin

# Browser Basic Pitch is opt-in. When true, the @spotify/basic-pitch model
# loads from the unpkg CDN on first use.
NEXT_PUBLIC_ENABLE_BASIC_PITCH_BROWSER=false

# Optional public URL for the local PYIN worker (workers/basic-pitch-service).
# When set, browser-yin first tries this for higher-accuracy transcription.
NEXT_PUBLIC_BASIC_PITCH_WORKER_URL=

# Eazo app id (used by the React SDK to identify the app).
NEXT_PUBLIC_EAZO_APP_ID=

# ─── Server-only — never expose to the browser ───────────────────────

# Eazo private key — required for requireAuth() session decryption AND for
# AI calls (the Strummer LLM endpoint configures ai with this).
EAZO_PRIVATE_KEY=your_eazo_private_key_here
EAZO_APP_ID=your_eazo_app_id_here

# Legacy Python worker URL (server-side fallback used by /api/transcribe).
# Modern flow uses NEXT_PUBLIC_BASIC_PITCH_WORKER_URL directly from the
# browser; this stays for the legacy /api/transcribe route.
BASIC_PITCH_WORKER_URL=

# ─── Database (Drizzle ORM) ──────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/myapp
POSTGRES_URL=

# Optional Turso/libSQL alternative
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Vercel Cron shared secret
CRON_SECRET=replace_with_a_long_random_string
