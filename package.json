{
  "name": "murmur",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.9",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "check:links": "node scripts/check-links.mjs",
    "test": "bun test",
    "test:audio": "if [ -d workers/audio-engine ]; then cd workers/audio-engine && python3 -m unittest discover -s tests; elif [ -f workers/basic-pitch-service/main.py ]; then python3 -m py_compile workers/basic-pitch-service/main.py; else echo 'No audio worker tests configured'; fi",
    "test:audio:full": "if [ -d workers/audio-engine ]; then cd workers/audio-engine && python3 -m unittest discover -s tests_full; elif [ -f workers/basic-pitch-service/main.py ]; then python3 -m py_compile workers/basic-pitch-service/main.py; else echo 'No full audio worker tests configured'; fi",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/lib/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:drop": "drizzle-kit drop"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1060.0",
    "@aws-sdk/s3-request-presigner": "^3.1060.0",
    "@fontsource/lxgw-wenkai-tc": "^5.2.9",
    "@base-ui/react": "^1.4.0",
    "@breezystack/lamejs": "^1.2.7",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.38.0",
    "geist": "^1.7.2",
    "html2canvas": "^1.4.1",
    "idb": "^8.0.0",
    "lucide-react": "^1.8.0",
    "next": "16.2.4",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.3.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tone": "^14.7.77",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
