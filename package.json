{
  "name": "murmur",
  "version": "0.7.0-rc.2",
  "private": true,
  "packageManager": "bun@1.3.9",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "next dev --webpack",
    "dev:stack": "bash scripts/dev-stack.sh",
    "workers:install": "bash scripts/murmur-services.sh install",
    "workers:status": "bash scripts/murmur-services.sh status",
    "workers:restart": "bash scripts/murmur-services.sh restart",
    "workers:stop": "bash scripts/murmur-services.sh stop",
    "deploy:music-serverless": "\"${npm_execpath:-bun}\" run scripts/deploy-music-serverless.ts",
    "deploy:music-gpu": "\"${npm_execpath:-bun}\" run scripts/deploy-music-serverless.ts",
    "pod:create": "\"${npm_execpath:-bun}\" run scripts/music-pod.ts create",
    "pod:start": "\"${npm_execpath:-bun}\" run scripts/music-pod.ts start",
    "pod:stop": "\"${npm_execpath:-bun}\" run scripts/music-pod.ts stop",
    "pod:status": "\"${npm_execpath:-bun}\" run scripts/music-pod.ts status",
    "waffo:bootstrap": "\"${npm_execpath:-bun}\" run scripts/waffo-bootstrap.ts",
    "waffo:webhook-register": "\"${npm_execpath:-bun}\" run scripts/waffo-webhook-register.ts",
    "waffo:reconcile": "\"${npm_execpath:-bun}\" run scripts/waffo-reconcile.ts",
    "dev:audio": "cd workers/audio-engine && ./.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8001",
    "dev:music": "cd workers/music-engine && ./.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8002",
    "setup:music": "bash workers/music-engine/setup.sh",
    "test:music": "cd workers/music-engine && MUSIC_ENGINE_MOCK=1 ./.venv/bin/python -m unittest discover -s tests",
    "smoke:local": "\"${npm_execpath:-bun}\" run scripts/local-stack-smoke.ts",
    "smoke:pages": "\"${npm_execpath:-bun}\" run scripts/page-contract-smoke.ts",
    "qa:report": "\"${npm_execpath:-bun}\" run scripts/qa-report.ts",
    "i18n:audit": "\"${npm_execpath:-bun}\" run scripts/i18n-audit.ts",
    "verify:local": "\"${npm_execpath:-bun}\" run smoke:local && \"${npm_execpath:-bun}\" run smoke:pages && \"${npm_execpath:-bun}\" run check:links && \"${npm_execpath:-bun}\" run lint && \"${npm_execpath:-bun}\" run test:audio",
    "setup:audio": "cd workers/audio-engine && python3 -m venv .venv && ./.venv/bin/python -m ensurepip --upgrade && ./.venv/bin/pip install -r requirements.txt",
    "audit:audio": "cd workers/audio-engine && ./.venv/bin/python tools/audio_audit.py --pretty",
    "audit:audio:compare": "cd workers/audio-engine && ./.venv/bin/python tools/audio_audit.py --pretty --all-providers",
    "audit:audio:gate": "cd workers/audio-engine && ./.venv/bin/python tools/audio_audit.py --pretty --all-providers --strict",
    "audit:audio:closure": "cd workers/audio-engine && ./.venv/bin/python tools/audio_eval_closure.py --pretty",
    "audit:audio:closure:smoke": "cd workers/audio-engine && ./.venv/bin/python tools/audio_eval_closure.py --config tools/audio_eval_closure.smoke.json --pretty",
    "audit:audio:closure:report": "cd workers/audio-engine && ./.venv/bin/python tools/audio_eval_closure.py --config tools/audio_eval_closure.report.json --pretty --markdown-out tools/reports/audio-closure.md",
    "audit:audio:humtrans": "cd workers/audio-engine && ./.venv/bin/python tools/audio_eval_closure.py --config tools/audio_eval_humtrans.json --pretty",
    "audit:audio:acceptance": "\"${npm_execpath:-bun}\" run scripts/audio-acceptance.ts",
    "audit:audio:acceptance:full": "\"${npm_execpath:-bun}\" run scripts/audio-acceptance.ts --with-lint --with-build",
    "audit:audio:manifest:help": "cd workers/audio-engine && ./.venv/bin/python tools/build_dataset_manifest.py --help",
    "audit:audio:dataset:help": "cd workers/audio-engine && ./.venv/bin/python tools/prepare_public_dataset.py vocadito --help",
    "audit:audio:scaffold": "cd workers/audio-engine && ./.venv/bin/python tools/scaffold_audio_eval_workspace.py --pretty",
    "audit:audio:seed-golden": "cd workers/audio-engine && ./.venv/bin/python tools/seed_murmur_golden.py --pretty",
    "db:up": "docker compose up -d murmur-postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f murmur-postgres",
    "build": "\"${npm_execpath:-bun}\" run scripts/env-audit.ts && next build --webpack",
    "build:audit": "\"${npm_execpath:-bun}\" run scripts/env-audit.ts && \"${npm_execpath:-bun}\" run scripts/build-audit.ts",
    "env:audit": "\"${npm_execpath:-bun}\" run scripts/env-audit.ts",
    "check:links": "node scripts/check-links.mjs",
    "test": "\"${npm_execpath:-bun}\" test",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install chromium",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "test:audio": "cd workers/audio-engine && ./.venv/bin/python -m unittest discover -s tests",
    "test:audio:full": "cd workers/audio-engine && ./.venv/bin/python -m unittest discover -s tests_full",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "\"${npm_execpath:-bun}\" src/lib/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:drop": "drizzle-kit drop"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1085.0",
    "@aws-sdk/s3-request-presigner": "^3.1085.0",
    "@base-ui/react": "^1.6.0",
    "@breezystack/lamejs": "^1.2.7",
    "@fontsource/lxgw-wenkai-tc": "5.2.9",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@waffo/pancake-ts": "^0.17.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn-fontsource-lxgw-wen-kai-gb-screen": "1.0.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.42.2",
    "geist": "^1.7.2",
    "html2canvas": "^1.4.1",
    "lucide-react": "^1.24.0",
    "next": "16.2.12",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-intersection-observer": "^10.1.0",
    "resend": "^6.17.2",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tone": "^14.7.77",
    "tw-animate-css": "^1.4.0",
    "ulid": "^3.0.2",
    "undici": "^8.7.0",
    "essentia.js": "^0.1.3",
    "web-push": "3.6.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "@modelcontextprotocol/sdk": "1.30.0",
    "bn.js": "4.12.5",
    "body-parser": "2.3.0",
    "brace-expansion": "5.0.8",
    "esbuild": ">=0.28.1",
    "fast-uri": "3.1.4",
    "hono": "4.12.32",
    "js-yaml": "4.3.0",
    "minimatch": "10.2.5",
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.3.14",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "3.6.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
